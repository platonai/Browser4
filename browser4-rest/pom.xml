                <exclusion>
                    <groupId>ai.platon.pulsar</groupId>
                    <artifactId>pulsar-browser</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ai.platon.pulsar</groupId>
                    <artifactId>pulsar-protocol</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ai.platon.pulsar</groupId>
                    <artifactId>pulsar-skeleton</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


