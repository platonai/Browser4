<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.platon.pulsar</groupId>
        <artifactId>browser4-core</artifactId>
        <version>4.16.6-SNAPSHOT</version>
    </parent>

    <artifactId>browser4-behavior-api</artifactId>

    <name>Browser4 Behavior API</name>
    <description>
        Replaceable browser stealth and interaction-humanization SPI. The module defines the
        contracts and the provider registry only; the community default implementation lives in
        browser4-behavior-default, and a professional or custom edition supplies its own module.
    </description>

    <dependencies>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-common</artifactId>
        </dependency>

        <!-- ChromeOptions / BrowserSettings / WebDriver: the contracts are browser-facing. -->
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-browser</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-common</artifactId>
            <exclusions>
                <exclusion>
                    <!-- kotlin-serialization (compiler plugin) depends on
                         kotlin-gradle-plugin-api; neither belongs at runtime -->
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-serialization</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-gradle-plugin-api</artifactId>
                </exclusion>
                <exclusion>
                    <!-- log4j-core (~2.5 MB) is redundant: log4j-to-slf4j (also on
                         classpath) already routes log4j API calls to SLF4J → logback. -->
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
