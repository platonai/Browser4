<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.platon.pulsar</groupId>
        <artifactId>browser4-plugins</artifactId>
        <version>4.12.0-rc.1</version>
    </parent>

    <artifactId>browser4-parse</artifactId>
    <name>Browser4 Parse</name>

    <dependencies>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-resources</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-skeleton</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-persist</artifactId>
            <exclusions>
                <!-- gora-core pulls in spark-core_2.13 which pulls the entire Hadoop+Scala+ZooKeeper
                     ecosystem (approx 100 MB). Browser4 uses only the Gora persistency API (PersistentBase)
                     for GWebPage and Avro serialization; it does not need Spark's RDD/DataFrame engine. -->
                <exclusion>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>spark-core_2.13</artifactId>
                </exclusion>
                <!-- Avro 1.8 pulls in Jackson 1.x (org.codehaus.jackson) which is redundant
                     with Jackson 2.x and Jackson 3.x already on the classpath. -->
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-core-asl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.jackson</groupId>
                    <artifactId>jackson-mapper-asl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>net.sourceforge.nekohtml</groupId>
            <artifactId>nekohtml</artifactId>
        </dependency>

        <!-- For parsers.
          The core library, tika-core, contains the key interfaces and classes of Tika and can be used by itself
          if you don't need the full set of parsers from the tika-parsers component.
         -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <!-- Provide only the html parser, other parsers should be provided in projects -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-html-module</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
