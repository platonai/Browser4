<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone build for the OS-input prototype.

  This module deliberately has NO Browser4 dependency: the geometry math and the two
  pointer drivers are plain JDK 25 code (java.awt.Robot / java.lang.foreign), so the
  prototype can be compiled and unit-tested without the Browser4 reactor.

  WHY `.example`: the file is not named `pom.xml` on purpose. `RepoConsistencyCheck`
  walks the repo for `pom.xml` files and requires every live module to be listed in the
  static `ModuleMap.MODULES` snapshot (browser4-coding/.../ModuleMap.kt) and in the root
  pom's <modules>. Neither file can be edited from an agent workspace (root pom and
  browser4-coding are protected), so a live `pom.xml` here would make
  `validate repo-consistency` fail with "ModuleMap.MODULES is missing
  'browser4-os-input-prototype'". Copy the file to `pom.xml` locally to build, and drop
  the copy again before validating / committing. Registering the module for real is part
  of promoting the prototype to `browser4-plugins/browser4-os-input` (README section 5).
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.platon.pulsar.prototype</groupId>
    <artifactId>browser4-os-input-prototype</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Browser4 OS Input Prototype</name>
    <description>
        Prototype of a cross-application click plugin: converts Browser4 viewport coordinates
        into OS screen coordinates and drives the desktop pointer with java.awt.Robot or Win32
        SendInput (via java.lang.foreign, no JNA).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>2.3.21</kotlin.version>
        <kotlin.jvmTarget>25</kotlin.jvmTarget>
        <junit.version>5.11.4</junit.version>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keep jupiter / platform / launcher on one line: surefire's JUnit Platform
                 provider refuses to discover tests when they drift apart. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <!-- Outside the Browser4 reactor nothing registers src/main/kotlin
                                 as a source root (the root pom does it with build-helper), so
                                 the Kotlin mojos are told explicitly. -->
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                </configuration>

            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
