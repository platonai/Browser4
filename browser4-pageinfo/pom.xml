<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Browser4 Plugin Project: browser4-pageinfo

        Uses the Browser4 PDK as parent (provides Kotlin 2.3.21 + JVM 17
        compiler configuration and consistent versions via browser4-pdk-bom).
        All Browser4 and Spring dependencies use "provided" scope because
        the host Browser4 application provides them at runtime.
    -->
    <parent>
        <groupId>ai.platon.pulsar</groupId>
        <artifactId>browser4-pdk</artifactId>
        <version>4.13.6-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>browser4-pageinfo</artifactId>
    <packaging>jar</packaging>

    <name>browser4-pageinfo</name>
    <description>Extract page title, URL and meta tags via browser-side JavaScript</description>

    <dependencies>

        <!-- ================================================================
             Browser4 Core API (provided by host at runtime)
             ================================================================ -->

        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-skeleton</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-protocol</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>browser4-agentic</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================================
             Spring Boot (provided by host at runtime)
             ================================================================ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================================
             Kotlin (provided by host at runtime)
             ================================================================ -->

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================================
             Testing
             ================================================================ -->

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>2.3.21</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>4.0.6</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Browser4-Plugin-Version>4.13.6-SNAPSHOT</Browser4-Plugin-Version>
                            <Created-By>Browser4 Plugin SDK</Created-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
